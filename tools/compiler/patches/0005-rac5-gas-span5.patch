+/* The retail R5900 assembler pads short loops: when a backward branch is
+   closer than five words to its target, it inserts nops immediately before
+   the branch so that the distance from the target to the branch (the branch
+   itself included, the delay slot excluded) is exactly five words.  The
+   rule applies inside a `.set noreorder' block too, which is where the
+   compiler emits its branches, and it is limited to backward branches: a
+   forward label has not been placed yet and is never padded.  A loop whose
+   body already contains a branch or jump is left alone.  */
+
+static int
+r5900_branch_or_jump_p (p)
+     bfd_byte *p;
+{
+  unsigned long insn = bfd_get_32 (stdoutput, p);
+  unsigned int op = (insn >> 26) & 0x3f;
+  unsigned int rt = (insn >> 16) & 0x1f;
+  unsigned int funct = insn & 0x3f;
+
+  if (op >= 2 && op <= 7)
+    return 1;			/* j jal beq bne blez bgtz */
+  if (op >= 0x14 && op <= 0x17)
+    return 1;			/* beql bnel blezl bgtzl */
+  if (op == 0 && (funct == 8 || funct == 9))
+    return 1;			/* jr jalr */
+  if (op == 1 && (rt <= 3 || (rt >= 0x10 && rt <= 0x13)))
+    return 1;			/* bltz .. bgezal, likely variants */
+  if ((op == 0x11 || op == 0x12) && rt <= 3)
+    return 1;			/* bc1f .. bc2t */
+  return 0;
+}
+
+
+/* True when INSN is a load or a store: its rs field is a memory base.  */
+
+static int
+r5900_is_memory_insn (insn)
+     unsigned long insn;
+{
+  unsigned int op = (insn >> 26) & 0x3f;
+
+  return (op == 0x1e || op == 0x1f
+	  || (op >= 0x20 && op <= 0x2e)
+	  || (op >= 0x30 && op <= 0x3f));
+}
+
+/* Number of nops to insert before the branch being appended, or 0.  */
+
+static int
+r5900_short_loop_nops (address_expr)
+     expressionS *address_expr;
+{
+  symbolS *sym;
+  fragS *frag;
+  offsetT target_off;
+  long bytes = 0;
+  int off, size;
+
+  if (address_expr == NULL || address_expr->X_op != O_symbol)
+    return 0;
+  sym = address_expr->X_add_symbol;
+  if (sym == NULL || sym->sy_frag == NULL
+      || sym->sy_frag == &zero_address_frag)
+    return 0;
+
+  frag = sym->sy_frag;
+  target_off = sym->sy_value.X_add_number;
+
+  for (;;)
+    {
+      size = (frag == frag_now) ? (int) frag_now_fix () : (int) frag->fr_fix;
+      if (size < target_off)
+	return 0;
+      for (off = target_off; off + 4 <= size; off += 4)
+	if (r5900_branch_or_jump_p ((bfd_byte *) frag->fr_literal + off))
+	  return 0;
+      bytes += size;
+      if (frag == frag_now)
+	break;
+      target_off = 0;
+      frag = frag->fr_next;
+      if (frag == NULL)
+	return 0;		/* forward target: never reached frag_now */
+    }
+
+  bytes -= sym->sy_value.X_add_number;
+  if (bytes < 0 || (bytes & 3) != 0)
+    return 0;
+  bytes /= 4;
+  if (bytes <= 3)
+    return (int) (4 - bytes);	/* target..branch spans five words */
+  return 0;
+}
